# Copy this file to .env and replace CHANGE_ME with your database password.
# Port 5432 for postgres default
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://anibants:CHANGE_ME@localhost:5432/anibants?sslmode=disable
GOOSE_MIGRATION_DIR=db/migrations

# Used by the Go app. Same database as above.
DATABASE_URL=postgres://anibants:CHANGE_ME@localhost:5433/anibants?sslmode=disable

# Optional: these all have defaults.
# REDIS_JOBS_ADDR=localhost:6380
# REDIS_CACHE_ADDR=localhost:6381
# LOG_FORMAT=text          # text (readable) or json (servers)
# LOG_LEVEL=info           # debug, info, warn or error
# WORKER_CONCURRENCY=20
